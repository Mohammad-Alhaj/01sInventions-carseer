@model VehicleSearchViewModel
@{
    ViewData["Title"] = "Vehicle Model Search";
    var showTypeColumn = Model.Models?.Any(m => m.VehicleTypeName is not null) == true;
}

<h1 class="h3 mb-3">Vehicle Model Search</h1>
<p class="text-muted">Find vehicle models by make, model year and vehicle type using the NHTSA vPIC database.</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Search" method="get" novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label asp-for="MakeId" class="form-label"></label>
                    <select asp-for="MakeId" id="makeSelect" class="form-select"
                            asp-items="@(new SelectList(Model.Makes, nameof(VehicleMake.Id), nameof(VehicleMake.Name)))"
                            data-types-url="@Url.Action("VehicleTypes")">
                        <option value="">Select a make...</option>
                    </select>
                    <span asp-validation-for="MakeId" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" type="number" class="form-control" placeholder="e.g. 2015"
                           min="@VehicleSearchViewModel.MinYear" max="@VehicleSearchViewModel.MaxYear" />
                    <span asp-validation-for="Year" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="VehicleType" class="form-label"></label>
                    <select asp-for="VehicleType" id="vehicleTypeSelect" class="form-select"
                            asp-items="@(new SelectList(Model.VehicleTypes, nameof(VehicleType.Name), nameof(VehicleType.Name)))"
                            disabled="@(Model.MakeId is null)">
                        <option value="">Any type</option>
                    </select>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Models is { Count: 0 })
{
    <div class="alert alert-info" role="alert">
        No models found for <strong>@Model.SelectedMakeName</strong> in <strong>@Model.Year</strong>@(string.IsNullOrEmpty(Model.VehicleType) ? "" : $" ({Model.VehicleType})").
    </div>
}
else if (Model.Models is not null)
{
    <div class="d-flex align-items-center mb-2">
        <h2 class="h5 mb-0 me-2">@Model.SelectedMakeName @Model.Year models</h2>
        <span class="badge bg-secondary">@Model.Models.Count</span>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
            <tr>
                <th>Model</th>
                <th>Model ID</th>
                @if (showTypeColumn)
                {
                    <th>Vehicle Type</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var vehicleModel in Model.Models)
            {
                <tr>
                    <td>@vehicleModel.Name</td>
                    <td class="text-muted">@vehicleModel.Id</td>
                    @if (showTypeColumn)
                    {
                        <td>@vehicleModel.VehicleTypeName</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
